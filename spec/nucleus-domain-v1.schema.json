{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nucleus.domain/v1",
  "title": "Model Forge domain configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["student", "corpus", "eval", "fidelity"],
  "properties": {
    "student": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base"],
      "properties": {
        "base": {"type": "string", "minLength": 1}
      }
    },
    "teacher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {"type": "string", "enum": ["local", "gateway", "mixed"]},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {"type": "string", "enum": ["queuellm", "ollama", "airllm"]},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "cutoff"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^(git|cve|lkml|lwn|world):[a-z0-9][a-z0-9_-]*$"}
        },
        "cutoff": {"type": "string"}
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cert_set", "eyeball_prompts", "dev_fraction"],
      "properties": {
        "cert_set": {"type": "string"},
        "eyeball_prompts": {"type": "string", "minLength": 1},
        "dev_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
        "cert_n": {"type": "integer", "minimum": 1}
      }
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "distill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top_n": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "shard": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}
  }
}
