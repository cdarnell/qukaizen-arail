# =============================================================================
# Autoresearch AI Lab — configuration
# =============================================================================
# Copy this file:  cp .env.example .env
# Then run:        ./lab setup
#
# The setup script fills in detected hardware, install tier, and a generated
# passphrase for you. Only edit .env by hand if you know what you're doing.
#
# ─── SAFETY ────────────────────────────────────────────────────────────────
#   • .env is git-ignored. Never force-add it.
#   • API keys and the lab passphrase live in .env — do not share this file.
#   • Provider tokens (Claude / NVIDIA / OpenRouter) can be saved from the
#     Chat tab instead of edited here. Those land in lab/data/secrets.env
#     with 0600 permissions and are also git-ignored.
#   • To rotate the lab passphrase: ./lab setup and answer "new".
# ───────────────────────────────────────────────────────────────────────────

# -----------------------------------------------------------------------------
# BRAND — name this lab whatever you want.
#
# Every visible surface (portal title, nav logo, activity log, status banners,
# setup screen, wiki landing) reads LAB_NAME at runtime. The Python package
# name stays `arail` so imports and the CLI don't break, but everything the
# operator *sees* rebrands from one .env edit.
#
# Default is "Autoresearch AI Lab". Rename to make it yours, e.g.:
#   LAB_NAME="Sam's AI Lab"
#   LAB_NAME="gentoofoo's ai lab"
#   LAB_NAME="PeanutLab"
# -----------------------------------------------------------------------------
LAB_NAME="Autoresearch AI Lab"
LAB_SHORT_NAME=autoresearch-lab
LAB_TAGLINE="A learn-by-doing AI research lab"
# Optional — nav-bar glyph. Defaults to ⟨${LAB_NAME}⟩.
# LAB_LOGO="⟨Autoresearch⟩"

# -----------------------------------------------------------------------------
# INSTALL TIER — set by `./arailctl setup`; determines which tabs appear.
#
#   minimalist → Dashboard, Chat, Autoresearch, Knowledge, Agents, Docs
#                The everyday lab. Ships llama-ai-eng (an AI-engineer persona
#                built with Llama-3.2-1B-Instruct, ~0.9 GB) as the only default
#                model. External providers (Claude / NVIDIA /
#                OpenRouter / HF) still work when LAB_MODE=hybrid — they
#                just use plain HTTP, no SDK.
#   maximus    → + Admin, Notebooks, AeroLLM deep-mode streaming, official
#                Anthropic SDK, LangChain + LangGraph, full cloud catalog.
#
# Legacy `min`/`max` values are auto-migrated with a deprecation warning
# (compat shim removed in v1.1.0).
#
# Upgrade later with: ./arailctl upgrade maximus
# -----------------------------------------------------------------------------
LAB_TIER=minimalist

# -----------------------------------------------------------------------------
# MODE: "airgapped" (default) or "hybrid"
#   airgapped = local models only, no network calls
#   hybrid    = local first, cloud fallback allowed (needs API keys below)
# -----------------------------------------------------------------------------
LAB_MODE=airgapped
# Legacy alias (still honored):
# ARAIL_MODE=airgapped

# -----------------------------------------------------------------------------
# TRUSTED HOSTS — anti-DNS-rebinding Host allowlist.
# The portal has no auth; loopback is the trust boundary. Requests whose
# Host header isn't 127.0.0.1 / localhost / ::1 are refused (protects
# against a malicious web page rebinding a domain to 127.0.0.1 to reach
# the lab through your browser). If you front the lab with a reverse proxy
# that preserves a custom Host (e.g. lab.example.com), list it here
# (comma-separated). A specific LAN BIND_ADDR is auto-allowed; a wildcard
# bind (0.0.0.0) disables the check — run your own front door there.
# ARAIL_ALLOWED_HOSTS=lab.example.com

# -----------------------------------------------------------------------------
# DEFAULT COMPUTE SOURCE (the Chat tab lets you pivot live without editing this)
#
# Options: my_machine | claude | nvidia | openrouter | huggingface | custom
#   my_machine  → local MLX / CUDA / CPU — no key needed
#   claude      → Anthropic API          — needs ANTHROPIC_API_KEY
#   nvidia      → NVIDIA NIM             — needs NVIDIA_API_KEY
#   openrouter  → OpenRouter             — needs OPENROUTER_API_KEY
#   huggingface → HF Inference API       — needs HF_TOKEN
#   custom      → any OpenAI-compatible endpoint (set MODEL_API_BASE)
# -----------------------------------------------------------------------------
COMPUTE_SOURCE=my_machine

# -----------------------------------------------------------------------------
# MODEL BACKEND (for the my_machine compute source)
# `./lab setup` detects your hardware and writes the matching backend.
# Options: mlx | cuda | cpu | airllm | aerollm | openai_compat | huggingface | openrouter | claude
# -----------------------------------------------------------------------------
MODEL_BACKEND=ollama_native
MODEL_NAME=llama-ai-eng
LOCAL_API_PORT=8000

# -----------------------------------------------------------------------------
# OPENAI-COMPATIBLE / CUSTOM ENDPOINTS
# Any service speaking the OpenAI /v1/chat/completions protocol works here.
# -----------------------------------------------------------------------------
# — Local servers —
# MODEL_API_BASE=http://localhost:1234/v1    # LM Studio
# MODEL_API_BASE=http://localhost:11434/v1   # Ollama
# MODEL_API_KEY=not-needed
#
# — NVIDIA NIM (build.nvidia.com) — free credits, OpenAI-compatible —
# MODEL_API_BASE=https://integrate.api.nvidia.com/v1
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MODEL_NAME=meta/llama-3.3-70b-instruct

# -----------------------------------------------------------------------------
# CLOUD API KEYS (only used when LAB_MODE=hybrid)
# The Chat tab's "Save token" button writes these to lab/data/secrets.env
# (chmod 0600, git-ignored) instead of editing this file directly.
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# NVIDIA_API_KEY=nvapi-xxxxx
# OPENROUTER_API_KEY=sk-or-xxxxx
# HF_TOKEN=hf_xxxxx                 # also used by gated HF model downloads

# -----------------------------------------------------------------------------
# PATHS — runtime state lives under ./lab/ by default.
# -----------------------------------------------------------------------------
# LAB_ROOT=./lab
# LAB_DATA_DIR=./lab/data                  # activity log, goals, experiments, consent
# LAB_MODELS_DIR=./lab/models              # downloaded model weights
# LAB_PKB=./lab/pkb                        # knowledge base (inbox, sources, notes)
# LAB_EXPERIMENTS_DIR=./lab/data/experiments
# LANCE_PATH=./lab/data/lance              # Lance-backed vector index (maximus)
# LANCE_PORT=7414

# -----------------------------------------------------------------------------
# AGENT INTENT — the domain context the researcher thinks in.
# Options: ai | farming | ml | business | education | health | culinary
# -----------------------------------------------------------------------------
LAB_INTENT=ai
LAB_INTENT_NAME="AI Engineer"

# -----------------------------------------------------------------------------
# LAB THEME — the north-star research area. Shows in the Mission Objective
# card above whatever specific goal is active.
# -----------------------------------------------------------------------------
LAB_THEME="Making SSD-hosted model inference faster — frontier open-weight models on laptop hardware"

# -----------------------------------------------------------------------------
# SCHEDULER — when the lab does light vs heavy work.
#   active hours → small-model chat, stays responsive
#   heavy  hours → long-running experiments, GPU burn
# -----------------------------------------------------------------------------
LAB_ACTIVE_HOURS=08:00-22:00
LAB_HEAVY_HOURS=22:00-08:00
LAB_STARTUP_DELAY_SEC=300

# -----------------------------------------------------------------------------
# PERSONALITY AGENTS (maximus tier)
# LAB_BUDDY — ARAIL's lab partner. Observes the lab AND offers goal-
#             aware suggestions (techniques, reviews, runs) on a slow cadence.
# LAB_SRE   — crash monitor. Surfaces errors and recurrences.
#
# Buddy tuning (optional):
#   LAB_BUDDY_INTERVAL_SEC          — watcher tick (default 90)
#   LAB_BUDDY_GLOBAL_COOLDOWN_SEC   — silence after any utterance (default 300)
#   LAB_BUDDY_SUGGEST_INTERVAL_SEC  — proactive cadence (default 900 = 15 min)
# -----------------------------------------------------------------------------
LAB_BUDDY=on
LAB_SRE=on

# -----------------------------------------------------------------------------
# WIKI — documentation-as-code auto-rebuild behavior.
# -----------------------------------------------------------------------------
LAB_WIKI_AUTO_REBUILD=true
LAB_WIKI_REBUILD_DEBOUNCE_SEC=30

# -----------------------------------------------------------------------------
# AIRLLM — optional deep layer-streaming backend (opt-in as of v1.0.0).
# Power users on CUDA/Linux can enable with: ARAIL_INSTALL_AIRLLM=1.
# Not installed by default in either tier; AeroLLM is the canonical deep
# backend for the Maximus tier.
# -----------------------------------------------------------------------------
# __TODO_DEEP_MODEL__ is a deliberate sentinel — AirLLM refuses to start
# until an operator sets a real value (see arail/router/backends.py
# AirLLMBackend). Do not ship a real model id here; a previous version of
# this file shipped meta-llama/Llama-3.1-70B, which silently defeated that
# fail-closed default for anyone who copied this file as-is.
AIRLLM_MODEL=__TODO_DEEP_MODEL__
AIRLLM_COMPRESSION=4bit
AIRLLM_MAX_LENGTH=512
AIRLLM_PACKAGE=airllm

# -----------------------------------------------------------------------------
# WHERE MODEL WEIGHTS LIVE
#   ARAIL_MODELS_DIR → root for downloaded weights (GGUF / MLX / safetensors).
#                      Default `lab/models` (repo-relative, git-ignored), which
#                      keeps a cloned lab self-contained. Ollama personas are
#                      NOT here — they live in Ollama's own store.
#
#   Shared-machine convention: on a box shared across QuKaiZen products, MLX
#   checkpoints are pooled world-readable at /Users/Shared/models (with
#   ~/models symlinked to it) so several macOS accounts read one copy instead
#   of duplicating hundreds of GB. Opt in by pointing the var at it — this is
#   deliberately NOT the default, since ARAIL is cloned onto other machines:
#     ARAIL_MODELS_DIR=/Users/Shared/models
#   Prefer that location when downloading new checkpoints on such a machine.
#   Full map of every artifact location: docs/models-on-disk.md
# -----------------------------------------------------------------------------
#ARAIL_MODELS_DIR=lab/models

# -----------------------------------------------------------------------------
# AEROLLM — Arail's Rust runtime; the deep-mode backend for the Maximus tier.
# Apple Silicon: native. CUDA hosts: fall back to AirLLM with a notice until
# AeroLLM's CUDA backend ships. Switches:
#   AEROLLM_MODEL          → directory under ARAIL_MODELS_DIR or absolute path.
#                             Default Qwen2.5-7B-4bit (~4 GB resident, fits
#                             16 GB Macs). Operators can override in .env.
#   AEROLLM_KV_BUDGET_PCT  → KV cache as a fraction of system RAM. 0.60 leaves
#                             headroom for portal + browser. Unset → aerollm
#                             auto-detects (80%) which is too aggressive for
#                             a box also running the lab UI.
#   AEROLLM_DRAFT_MODEL    → optional speculative-decoding draft (path or name).
#   AEROLLM_RING_DEPTH     → cap resident transformer-block weight slots
#                             (mlx-native only). 0 / unset → no eviction.
#   LAB_SHOW_AEROLLM=1     → surface AeroLLM tabs on the Tuning page.
#   AEROLLM_RESEARCH=true  → the autoresearch loop (researcher agent) may
#                             use AeroLLM for deep calls. Gates ONLY that
#                             loop — the Chat tab's deep slot and every
#                             other AeroLLM consumer are unaffected by
#                             this var; their availability is a capability
#                             fact (maximus tier + the wheel being built),
#                             not an opt-in flag (sprints/2026-08-11-two-
#                             slot-chat-models). Previously this ALSO
#                             silently hid the deep slot's registry row
#                             even on a maximus box with the wheel built —
#                             fixed; false below now only means "don't run
#                             unsupervised autoresearch on my Mac."
#                             The Autoresearch tab's "deep passes" toggle
#                             writes this key to .env (maximus only) — the
#                             tab's truth strip always shows the effective
#                             state.
#   ARAIL_FORCE_AEROLLM=1  → disable AirLLM fallback on CUDA (fail loud if
#                             AeroLLM CUDA backend is not yet available).
# -----------------------------------------------------------------------------
LAB_SHOW_AEROLLM=true
AEROLLM_MODEL=Qwen2.5-7B-Instruct-4bit
AEROLLM_KV_BUDGET_PCT=0.60
AEROLLM_RESEARCH=false
LAB_CHAT_DEEP_DEFAULT=false

# -----------------------------------------------------------------------------
# LAB PERSISTENCE — daemon mode + model warmth (see docs/persistence.md).
#   ./arailctl install-daemon    → launchd supervision: the lab starts at
#                                  login, respawns on crash, survives closing
#                                  the terminal. Logs: lab/logs/<svc>.{out,err}.log
#   ARAIL_OLLAMA_KEEP_ALIVE      → explicit override for Ollama keep_alive on
#                                  every request; always wins over the
#                                  ARAIL_RESIDENT_PIN logic below. "" disables
#                                  keep_alive entirely (Ollama's own default).
#   ARAIL_RESIDENT_PIN=1         → the two-slot redesign's "in the GPU at all
#                                  times" promise (sprints/2026-08-11-two-
#                                  slot-chat-models Part 3): the registry's
#                                  tier0/resident model pins forever (keep_
#                                  alive "-1") by default — every OTHER Ollama
#                                  model still gets the old 2h. Safe because
#                                  the resident slot is capped at <=3B by the
#                                  picker (never past the <8B ceiling): pinned
#                                  residency is ~1-2 GB, well under the
#                                  aeroLLM preload's 0.60 memory-pressure
#                                  ceiling. Set 0 to restore the pre-Part-3
#                                  2h-for-everything default.
#   ARAIL_TIER0_BOOT_WARM=1      → issue a 1-token completion at boot so the
#                                  resident model is actually loaded (default on).
#   ARAIL_TIER0_KEEPWATCH=1      → background loop that re-warms the resident
#                                  model if it goes cold between chat turns
#                                  (an eviction from outside the lab, a daemon
#                                  restart) — Ollama-only, since no live
#                                  residency probe exists for mlx/cpu/cuda.
#                                  Default on; 0 disables.
#   ARAIL_TIER0_KEEPWATCH_INTERVAL_SEC → keep-watch re-check interval (120,
#                                  floor 30).
#   ARAIL_AEROLLM_PRELOAD=1      → background-preload the Tier 1 deep model
#                                  when safe (operator absent, pressure < 0.60,
#                                  not halted). Default on; 0 disables.
#   ARAIL_AEROLLM_PRELOAD_INTERVAL_SEC → preload safe-window re-check (300).
# The halt flag and researcher run-state persist in lab/data/ — a halted lab
# stays halted across restarts, and an interrupted research run auto-resumes
# from its last checkpoint. Chat conversations persist under
# lab/pkb/conversations/ ("wipe the PKB = forget me").
# -----------------------------------------------------------------------------
#ARAIL_OLLAMA_KEEP_ALIVE=2h
#ARAIL_RESIDENT_PIN=1
#ARAIL_TIER0_BOOT_WARM=1
#ARAIL_TIER0_KEEPWATCH=1
#ARAIL_TIER0_KEEPWATCH_INTERVAL_SEC=120
#ARAIL_AEROLLM_PRELOAD=1
#ARAIL_AEROLLM_PRELOAD_INTERVAL_SEC=300

# -----------------------------------------------------------------------------
# MODEL REGISTRY — the unified model-resolution layer (arail.registry).
# Every tab resolves its model through registry task profiles (fast /
# reasoning / long_context / tool_use / build); bindings + per-tab overrides
# persist in lab/data/model_registry.json (edited via the Models pill in the
# status bar). Env stays a valid way to configure Tier 0/1 — the registry
# reconciles with MODEL_BACKEND / MODEL_NAME / AEROLLM_MODEL at load.
#   MODEL_HEALTH_INTERVAL_SEC → health re-probe cadence (default 60; 0 = one
#                                startup preflight then no re-probe loop).
#   OLLAMA_PORT               → Tier 0 Ollama port (default 11434). Note:
#                                ollama_native no longer inherits the LM
#                                Studio :1234 default when MODEL_API_BASE is
#                                unset — that was the AutoResearch outage.
# -----------------------------------------------------------------------------
#MODEL_HEALTH_INTERVAL_SEC=60

# -----------------------------------------------------------------------------
# QUIET BOOT / AUTOCHECKS — nothing probes or warms unless you ask.
#
# By default the lab boots quiet: no package/version/model probes, no weight
# warmers, no "MODEL TIER DOWN" noise, no subprocesses on the boot path. First
# byte is fast even with no model installed. The explicit checkup surface is
#   ./arailctl doctor              # models, KB index, components, egress
#   ./arailctl doctor --updates    # + remote update check (hybrid only)
# and, in the portal, the Models pill "Refresh" + the Admin "Check versions"
# and "Check Updates" buttons.
#
#   ARAIL_AUTOCHECKS=1   → restore the always-on background behaviour for power
#                          users: the model-registry health thread (interval
#                          re-probe), the Tier-0 boot warm, the aeroLLM preload,
#                          the Anthropic cache prewarm, and the hybrid boot CVE
#                          scan. Default 0 (off). Per-feature vars below still
#                          apply as overrides *within* this switch.
#   ARAIL_SKIP_CANVAS=1  → skip the Knowledge Canvas Neo4j connect at boot.
#   ARAIL_SKIP_MODEL_DOWNLOAD=1 → setup installs no model (prints the command
#                          to run later). Setup also skips automatically when
#                          the ollama daemon isn't reachable (no 15-min hang).
#
# The airgap/egress guard is NOT part of this switch — it always installs
# first at boot and is load-bearing. Quiet boot never means unguarded.
#
# Fully-silent recipe (also stops the two product loops that aren't probes):
#   ARAIL_AUTOCHECKS=0
#   LAB_DREAMS=off          # nightly reflection loop
#   LAB_INBOX_WATCH=0       # 10s inbox folder poll
# -----------------------------------------------------------------------------
#ARAIL_AUTOCHECKS=0

# -----------------------------------------------------------------------------
# MODEL BUILDING (Nucleus) — the /build tab drives the qukaizen-nucleus SSDP
# orchestrator. All localhost; reads are unauthenticated, mutations need the
# key. The orchestrator's default :8000 collides with the vLLM convention —
# point NUCLEUS_ORCHESTRATOR_URL elsewhere if you run both.
#   NUCLEUS_ORCHESTRATOR_URL → default http://127.0.0.1:8000
#   NUCLEUS_TRAINER_URL      → default http://127.0.0.1:8006 (loss/throughput)
#   NUCLEUS_API_KEY          → orchestrator mutation auth (X-API-Key)
#   NUCLEUS_CONFIGS_DIR      → nucleus configs/ tree for generated manifests
#                               (default ~/ProJects/qukaizen-nucleus/configs)
# The "Anthropix gateway (accelerated)" build option routes the nucleus
# teacher tier through the Anthropic API: requires LAB_MODE=hybrid and
# ANTHROPIC_API_KEY; rendered locked (never hidden) while airgapped.
# -----------------------------------------------------------------------------
#NUCLEUS_ORCHESTRATOR_URL=http://127.0.0.1:8000
#NUCLEUS_TRAINER_URL=http://127.0.0.1:8006
#NUCLEUS_API_KEY=
#NUCLEUS_CONFIGS_DIR=~/ProJects/qukaizen-nucleus/configs

# -----------------------------------------------------------------------------
# COST TRACKING — simulates equivalent cloud costs so you can compare.
# -----------------------------------------------------------------------------
ENERGY_RATE_KWH=0.13
SIM_BILL_MONTHLY_BASE_USD=20
SIM_BILL_USAGE_MULTIPLIER=2.0
SIM_BILL_AGENT_USAGE_MULTIPLIER=1.25
SIM_BILL_MIN_CALL_USD=0.002
SIM_BILL_INCLUDE_SUBSCRIPTION=true

# -----------------------------------------------------------------------------
# SERVICE PORTS
# -----------------------------------------------------------------------------
PORTAL_PORT=8080
TERMINAL_PORT=7681
NOTEBOOK_PORT=8888
IDE_PORT=8443

# -----------------------------------------------------------------------------
# UNIFIED PASSPHRASE — set by `./lab setup`. One secret for every lab surface.
# To rotate: ./lab setup and answer "new".
# -----------------------------------------------------------------------------
# LAB_PASSWORD=  (set by setup)

# -----------------------------------------------------------------------------
# ADD-ON SERVICES (opt-in, maximus tier)
#   docker compose -f compose/marimo.yml up -d
#   docker compose -f compose/open-notebook.yml up -d
# -----------------------------------------------------------------------------
MARIMO_PORT=2718
OPEN_NOTEBOOK_PORT=8502
OPEN_NOTEBOOK_API_PORT=5055
# OPEN_NOTEBOOK_ENCRYPTION_KEY mirrors LAB_PASSWORD. Set by ./lab setup.
