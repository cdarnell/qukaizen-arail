# ARAIL's model defaults -- pins plus the last-resolved cache, in one file.
#
# You normally do not need this file. At every start the portal works out
# the two models itself:
#   A -- the fast, resident chat model (an installed Ollama tag)
#   B -- the deep model AeroLLM streams in (a directory under
#        ARAIL_MODELS_DIR; maximus tier + the aerollm_api wheel only)
# choosing from what is installed and what this machine can hold, then loads
# them. Precedence per slot:  pin (below)  >  .env (MODEL_NAME /
# AEROLLM_MODEL)  >  auto  >  none. A pin that is not installed, too big or
# over the RAM budget never blocks boot -- it is skipped, and the portal's
# strip tells you why and how to fix it.
#
# Copy to model_defaults.yaml (gitignored, per-machine like .env) only to
# PIN a slot. Edit `pins` only: the `resolved` section is a cache that ARAIL
# rewrites on every boot (it is never a gate and never compared for drift).
# You can also pin from the portal (Resident chip / POST /api/models/pin).
# Deleting the file just means "re-resolve with no pins".

version: 2

pins:
  # a -- the fast, always-resident chat model: an installed Ollama tag
  # (see `ollama list`), under the 8B primary ceiling. null = auto.
  a: null
  # b -- the deep model: a directory name under lab/models/ (or
  # ARAIL_MODELS_DIR). null = auto, `none` = keep the deep slot OFF (use
  # this if a deep model crashes ARAIL while loading).
  b: null

# resolved:   # written by ARAIL -- do not edit
#   resolved_at: 2026-10-20T19:02:11-0700
#   a: {model: llama-ai-eng:latest, source: auto, reason: null, size_gb: 1.3}
#   b: {model: null, source: pin, reason: pinned off, size_gb: null}
#   warm: {a: ok, b: skipped}
