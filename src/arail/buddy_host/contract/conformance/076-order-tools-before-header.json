{
  "name": "order-tools-before-header",
  "method": "brain.chat",
  "setup": {},
  "request": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer $CREDENTIAL",
      "X-Buddy-Contract": "sha256:$CONTRACT_SHA256"
    },
    "body": {
      "model": "buddy-fast",
      "messages": [
        {
          "role": "system",
          "content": "You are Buddy, a QA expert. Answer from the qa-practice World terms only. Built with Llama."
        },
        {
          "role": "user",
          "content": "If a test also fails on main, can I call it pre-existing?"
        }
      ],
      "stream": true,
      "stream_options": {
        "include_usage": true
      },
      "max_tokens": 400,
      "tools": [
        {
          "type": "function"
        }
      ]
    }
  },
  "expect": {
    "status": 422,
    "error_code": "tools_not_allowed",
    "body_subset": {
      "error": {
        "type": "buddy_host_error",
        "code": "tools_not_allowed",
        "message": "Tools are not allowed on this edge."
      }
    }
  }
}
