{
  "name": "brain-chat-refused-prompt-too-large",
  "method": "brain.chat",
  "setup": {},
  "request": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer $CREDENTIAL",
      "X-Buddy-Contract": "sha256:$CONTRACT_SHA256"
    },
    "body": {
      "model": "buddy-fast",
      "messages": [
        {
          "role": "system",
          "content": "BUDDY-TURN/1 {\"trace_id\":\"0123456789abcdef\",\"channel\":\"telegram\",\"identity\":{\"pseudonym\":\"p_0123456789\",\"role\":\"talker\"},\"response_schema\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"kind\",\"answer\",\"cite\",\"propose\"],\"properties\":{\"kind\":{\"enum\":[\"answer\",\"abstain\",\"refuse\",\"escalate\"]},\"answer\":{\"type\":\"string\",\"maxLength\":600},\"cite\":{\"type\":\"array\",\"maxItems\":3,\"uniqueItems\":true,\"items\":{\"enum\":[\"pre-existing-failure\",\"flaky-test\"]}},\"propose\":{\"enum\":[\"none\",\"pause_research\"]}}}}\nYou are Buddy, a QA expert. Answer from the qa-practice World terms only. Built with Llama."
        },
        {
          "role": "user",
          "content": ""
        },
        {
          "role": "assistant",
          "content": ""
        },
        {
          "role": "user",
          "content": "q"
        }
      ],
      "stream": true,
      "stream_options": {
        "include_usage": true
      },
      "max_tokens": 400
    }
  },
  "expect": {
    "status": 422,
    "error_code": "prompt_too_large",
    "body_subset": {
      "error": {
        "type": "buddy_host_error",
        "code": "prompt_too_large",
        "message": "The prompt is larger than the edge allows."
      }
    }
  }
}
