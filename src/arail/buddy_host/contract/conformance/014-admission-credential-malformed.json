{
  "name": "admission-credential-malformed",
  "method": "handshake",
  "setup": {},
  "request": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer nope",
      "X-Buddy-Contract": "sha256:$CONTRACT_SHA256"
    },
    "body": {
      "v": 1,
      "contract_sha256": "$CONTRACT_SHA256",
      "buddy": {
        "version": "0.1.0",
        "nanobot_pin": "v0.3.5",
        "instance_id": "0123456789abcdef",
        "started_at": "$NOW-30s"
      },
      "world": {
        "slug": "qa-practice",
        "world_sha256": "abababababababababababababababababababababababababababababababab"
      }
    }
  },
  "expect": {
    "status": 401,
    "error_code": "credential_invalid",
    "body_subset": {
      "error": {
        "type": "buddy_host_error",
        "code": "credential_invalid",
        "message": "The Buddy credential is not valid."
      }
    }
  }
}
