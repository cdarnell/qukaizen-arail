{
  "name": "hold-all-refused-credential-invalid",
  "method": "hold_all",
  "setup": {},
  "request": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer $WRONG_CREDENTIAL",
      "X-Buddy-Contract": "sha256:$CONTRACT_SHA256"
    },
    "body": {
      "v": 1,
      "trace_id": "0123456789abcdef",
      "reason": "telegram_stop",
      "by": {
        "pseudonym": "p_0123456789",
        "role": "talker"
      }
    }
  },
  "expect": {
    "status": 401,
    "error_code": "credential_invalid",
    "body_subset": {
      "error": {
        "type": "buddy_host_error",
        "code": "credential_invalid",
        "message": "The Buddy credential is not valid."
      }
    }
  }
}
