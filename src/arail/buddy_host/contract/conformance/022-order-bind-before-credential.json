{
  "name": "order-bind-before-credential",
  "method": "handshake",
  "setup": {
    "bind_loopback": false
  },
  "request": {
    "headers": {
      "Content-Type": "application/json",
      "X-Buddy-Contract": "sha256:$CONTRACT_SHA256"
    },
    "body": {
      "v": 1,
      "contract_sha256": "$CONTRACT_SHA256",
      "buddy": {
        "version": "0.1.0",
        "nanobot_pin": "v0.3.5",
        "instance_id": "0123456789abcdef",
        "started_at": "$NOW-30s"
      },
      "world": {
        "slug": "qa-practice",
        "world_sha256": "abababababababababababababababababababababababababababababababab"
      }
    }
  },
  "expect": {
    "status": 403,
    "error_code": "bind_not_loopback",
    "body_subset": {
      "error": {
        "type": "buddy_host_error",
        "code": "bind_not_loopback",
        "message": "The lab is not bound to loopback, so the Buddy edge is off."
      }
    }
  }
}
