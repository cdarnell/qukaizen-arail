        # `set -u` with "unbound variable" (fixed only in bash 4.4+) — a
        # real trap here, since `_restart_start_argv` is legitimately empty
        # for a bare `./arailctl restart` with 0 live instances (T20b).
        # `${arr[@]:-}` is not a safe substitute: it silently turns "zero
        # args" into "one empty-string arg", which start.sh's parser would
        # then reject as an unknown flag. Guard the count explicitly instead.
        if (( ${#_restart_start_argv[@]} > 0 )); then
            if bash "$REPO_ROOT/scripts/start.sh" "${_restart_start_argv[@]}"; then
