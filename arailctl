        # operator who just interrupted it on purpose; only a GENUINE
        # start failure gets the DOWN notice.
        if (( _restart_rc != 0 && _restart_rc != 130 && _restart_rc != 143 )) \
            && [[ "$_restart_something_was_stopped" == "1" ]]; then
            echo "" >&2
            echo "restart: ${_restart_label} was stopped, and the start failed (above) — the lab is now DOWN." >&2
        fi
        exit "$_restart_rc"
