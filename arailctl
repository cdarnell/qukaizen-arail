            # snapshot must be taken first — stop_instance deletes the
            # record it would otherwise be read from).
            _restart_live=()
            while IFS= read -r _restart_s; do
                [[ -n "$_restart_s" ]] && inst_alive "$_restart_s" && _restart_live+=("$_restart_s")
            done < <(inst_list_slugs)
            unset _restart_s
            if (( ${#_restart_live[@]} == 0 )); then
                _restart_target_kind="root"  # start does its own resolution/picker
            elif (( ${#_restart_live[@]} == 1 )); then
                _restart_target_kind="world"; _restart_target_slug="${_restart_live[0]}"
            else
                # F12: silently picking one of >=2 live instances is the
                # bug this WP retires — name each command instead.
                echo "Multiple World instances are running — specify which to restart:" >&2
                for _restart_s in "${_restart_live[@]}"; do
                    echo "  ./arailctl restart --world ${_restart_s}" >&2
                done
                echo "  ./arailctl restart --root" >&2
                exit 2
            fi
        fi

