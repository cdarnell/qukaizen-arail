                    # start's daemon branch (also reachable as
                    # `restart --warm`, per §11.1).
                    for _restart_warm_arg in "$@"; do
                        if [[ "$_restart_warm_arg" == "--warm" ]]; then
                            echo "warm-up: — daemon mode: set ARAIL_TIER0_BOOT_WARM=1 in .env, then ./arailctl restart"
                            break
                        fi
                    done
                    unset _restart_warm_arg
                    exit 0
                fi
            fi
            if [[ -n "$_restart_degrade_reason" ]]; then
                # Pre-readiness-gate behavior: print the URL and exit 0 —
                # this box just can't tell us whether it actually came up.
                warn "$_restart_degrade_reason — assuming launchctl kickstart -k succeeded"
                say "Lab agents restarted (launchctl kickstart -k) — portal: ${_restart_url}"
                exit 0
            fi
            die "launchd kickstart -k issued but the portal did not answer within 30s — tail lab/logs/portal.err.log"
        fi

