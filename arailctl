            echo "restart --all is not supported: a foreground start hosts exactly one target." >&2
            echo "  (ARCHITECTURE.md §3.2 — multi-instance restart needs a supervisor, not built this sprint)" >&2
            echo "  Use:  ./arailctl stop --all, then in separate terminals:" >&2
            echo "        ./arailctl start --world <slug>   and/or   ./arailctl start --root" >&2
