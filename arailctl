        # stop phase actually stopped something. On a fresh clone (nothing
        # was ever up), reset.sh's own stop prints "No running services
        # found." / "no verified processes to stop." and still exits 0; a
        # subsequent start failure is then a bare start failure, not a
        # state change, and must not be announced as one. Capture the stop
        # phase's own narration (still echoed, same content/order as
        # before) so the DOWN notice can be gated on it having reported an
        # actual stop.
        _restart_something_was_stopped=1
        if [[ "$_restart_target_kind" == "world" ]]; then
            _restart_label="World instance '${_restart_target_slug}'"
            if ! _restart_stop_output="$(bash "$REPO_ROOT/scripts/reset.sh" stop --world "$_restart_target_slug" 2>&1)"; then
                echo "$_restart_stop_output"
                echo "restart: stopping ${_restart_label} failed — start not attempted." >&2
                exit 1
            fi
            echo "$_restart_stop_output"
            [[ "$_restart_stop_output" == *"no verified processes to stop"* ]] && _restart_something_was_stopped=0
        else
            _restart_label="the root lab"
            if ! _restart_stop_output="$(bash "$REPO_ROOT/scripts/reset.sh" stop --root 2>&1)"; then
                echo "$_restart_stop_output"
                echo "restart: stopping ${_restart_label} failed — start not attempted." >&2
                exit 1
            fi
            echo "$_restart_stop_output"
            [[ "$_restart_stop_output" == *"No running services found."* ]] && _restart_something_was_stopped=0
        fi
        unset _restart_stop_output

        _restart_start_argv=("$@")
        if [[ "$_restart_target_kind" == "world" && -z "$_restart_world" ]]; then
