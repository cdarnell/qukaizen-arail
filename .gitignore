# Environment & secrets
.env
.env.local
.env.*.local
.gh-token

# Per-machine model defaults (see model_defaults.yaml.example)
model_defaults.yaml
lab.conf
# Provider tokens saved from Chat > Compute Source (chmod 0600).
lab/data/secrets.env
# Personal financial data (debt-finance World input + agent findings) —
# chmod 0600, never PKB-indexed, never committed. Redundant with the
# broader lab/data/ rule below, same precedent as the secrets.env line
# above: named explicitly for human-scannability.
lab/data/user-import/

# Logs (anything ending in .log, plus a couple of historical names)
*.log
compile_stderr.txt
output.txt
traefik_logs.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
/build/
*.egg
.venv/
venv/
env/

# Node / frontend build artifacts
node_modules/
*.tsbuildinfo

# Runtime state (generated at setup/run time, never committed)
.transfer/
lab/data/
lab/models/
# Per-World instance runtime (concurrent Worlds) — instance roots, env
# packs, the liveness registry, and per-instance secrets. See
# sprints/2026-07-28-concurrent-worlds/ARCHITECTURE.md §1.4. No negation
# for registry.d/ — it is machine state (absolute paths, PIDs) and must
# never be committed.
lab/instances/
# Top-level models/ holds Ollama Modelfile scaffolds (tracked) plus any
# fetched weights (ignored). The /*/* pattern matches files inside
# subdirs so the parent dirs themselves stay un-excluded — which is
# what lets the `!.../Modelfile` re-include below take effect.
models/*/*
!models/*/Modelfile
# MODEL-TIERS-V2: persona-wrap Modelfiles (Modelfile.default, Modelfile.deep,
# Modelfile.preview, Modelfile.production are all tracked recipe files).
!models/*/Modelfile.*
# ai-eng bench artifacts committed per ARCHITECTURE §4.3 (2026-05-18-ai-eng-v2.1)
!models/ai-eng/bench-prompts.v2.1.yaml
!models/ai-eng/mmlu-sample-v2.1.json
!models/ai-eng/perplexity-corpus.txt
!models/ai-eng/BENCH-v2.1.md
# opencode lab-scoped config (generated at start; may contain env references, no secrets)
lab/.opencode/
lab/pkb/inbox/*
!lab/pkb/inbox/.gitkeep
lab/pkb/.wiki-cache/
# LanceDB-backed PKB vector index — auto-rebuilt on demand by arail.pkb.
lab/pkb/.cache/
# PKB sections that agents + docgen write to — re-seed / rebuild on demand.
lab/pkb/agents/
lab/pkb/compiled/
lab/pkb/inference/
lab/pkb/notes/
# lab/pkb/research/: only the contract files ship in the repo —
# README.md explains the triple, prepare.py is the validation substrate.
# Everything else under here (program.md, train.py, user notes, fetched
# sources) is runtime state and stays ignored. The `lab/pkb/research/*`
# form (instead of `lab/pkb/research/`) is required for the `!` negations
# below to take effect.
lab/pkb/research/*
!lab/pkb/research/README.md
!lab/pkb/research/prepare.py
lab/pkb/skills/
lab/pkb/sources/seeds/
# A World's staged pages, mirrored from lab/worlds/<slug>/ by mount() and
# rewritten by _run_grow(); swept and re-staged on every mount/switch
# (reset.sh's reset_pkb() also drops the whole tree). lab/worlds/<slug>/ is
# the source of truth and stays tracked; this copy never should have been.
lab/pkb/sources/world-*/
# lab/worlds/: the three SHIPPED default bundles are tracked; every World a
# user forges or mounts afterwards is their own lab state and must not be.
# Without this rule a real World (a kid's school-work World, a mounted
# demo) shows up as untracked noise in `git status` on every branch, and is
# one `git add -A` away from being committed into the product. Same
# `dir/*` + `!` negation form as lab/pkb/research/ above, for the same
# reason: the `/*` is required for the negations to take effect.
lab/worlds/*
!lab/worlds/README.md
!lab/worlds/ai/
!lab/worlds/qukaizen/
!lab/worlds/video-games/
# Repo-root experiments/: the research engine's own run records plus a LanceDB
# cache. ARAIL_EXPERIMENTS_DIR defaults to lab/data/experiments (already
# ignored) — this tree appears when the engine runs with the variable pointed
# at a bare relative path, so ignore the root location too rather than leave
# run output loose in `git status`.
experiments/
# Demo/seed content from the initial commits (Apr 2026) — regenerated by
# the starter-pack re-seed on first ./arailctl start, not user data.
lab/pkb/sources/bookmarks.md
lab/pkb/sources/articles/*
!lab/pkb/sources/articles/.gitkeep
lab/pkb/sources/images/
# Chat transcripts (docs/conversation-memory.md) — never belongs in git
# history; ./arailctl reset pkb is the only thing that should delete this.
lab/pkb/conversations/
lab/pkb/index.md
# Retrieval A/B harness scratch indexes (scripts/eval/retrieval_ab.py) —
# never committed; the committed artifacts are the fixtures + results.json.
lab/.eval-cache/

# Open Notebook container runtime state
compose/open-notebook/data/
compose/open-notebook/surreal/
compose/open-notebook/speaches-cache/
*.gguf
*.bin
*.safetensors

# Notebooks
notebooks/*.ipynb
!notebooks/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Sandbox can't unlink certain files; we mv them into .graveyard/ pending
# a human-run `rm -rf .graveyard/` on the host.
.graveyard/

# Do not track aerollm subtree in this repository
/aerollm/

# mypy / pytest
.mypy_cache/
.pytest_cache/
htmlcov/
.coverage
.ipynb_checkpoints/
.claude/

# Editor backup files
*.bak

# Librarian scan cache — regenerated wholesale on every scan (schema
# arail.librarian-scout/v1 carries a `last_scan` stamp), ~290 KB per World.
# Tracking it re-dirties the tree after each scan and bloats history for
# zero signal. World `evolution.json` IS tracked: it's an append-only
# record of evolution passes, not a cache.
lab/worlds/*/librarian-scout.json
examples/worlds/*/librarian-scout.json
